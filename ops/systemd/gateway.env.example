MESH_PUBLIC_URL=https://gateway.example.com
# On this VPS Caddy reaches this host bridge address; derive it from docker inspect.
MESH_LISTEN_HOST=172.19.0.1
MESH_REGISTRY_PATH=/var/lib/rhm-gateway/registry.json
MESH_GATEWAY_LOCK=/var/lib/rhm-gateway/gateway.lock
MESH_REGISTER_MODE=pair
MESH_ENROLL_SECRET=REPLACE_WITH_RANDOM_SECRET
MESH_ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
MESH_PRIVATE_HEALTH=1
MESH_LEGACY_SUBDOMAIN=0

# Google owner login. Create a Web OAuth client; keep its secret on the server.
# Authorized redirect URI: https://gateway.example.com/auth/google/callback
# Both empty = owner login disabled (admin API remains available).
MESH_GOOGLE_CLIENT_ID=
MESH_GOOGLE_CLIENT_SECRET=
